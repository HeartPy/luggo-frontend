# Public site URL (canonical / OGP / sitemap)
NUXT_PUBLIC_SITE_URL=https://luggo.com

# Backend API base URL
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Stripe Publishable Key
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google Maps API Key
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# E2E テスト用: 1 のとき Stripe.js を読み込まず決済をモックする
# （pnpm test:e2e の webServer が自動で 1 を設定するため通常は空でよい）
NUXT_PUBLIC_E2E_MOCK_STRIPE=

# Sentry（エラー監視）。未設定の場合は無効（開発では通常空でよい）
NUXT_PUBLIC_SENTRY_DSN=