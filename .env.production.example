# Public site URL (canonical / OGP / sitemap)
NUXT_PUBLIC_SITE_URL=https://your-domain.prod

# Backend API base URL
NUXT_PUBLIC_API_BASE_URL=https://api.your-domain.prod

# Stripe Publishable Key
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Google Maps API Key
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry（エラー監視）。未設定の場合は無効
NUXT_PUBLIC_SENTRY_DSN=
